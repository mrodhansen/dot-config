{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rose-pine-dawn",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch",
    "verbosity": "low"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "keybinds": {
    "session.tab.close": "ctrl+w",
    "session.tab.previous": "ctrl+shift+tab,alt+up,ctrl+h",
    "session.tab.next": "ctrl+tab,alt+down,ctrl+l",
    "session.new": "ctrl+n",
    "session.message.user.previous": "ctrl+k",
    "session.message.user.next": "ctrl+j",
    "input.newline": "shift+return,ctrl+return",
    "input.delete.to.line.end": false
  },
  "plugins": ["opencode-keep-going"],
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": false
  }
}

{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vscode-dark-plus"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "session.tab.close": "ctrl+w",
    "session.new": "ctrl+n"
  }
}
